# Saved state for checks: things that exist only for a moment, such as a
# plan before you approve it. Checks read it locally; it is never pushed.
.practice/

node_modules/
.DS_Store

# JetBrains IDEs keep project settings here; the checks would count the
# folder as an uncommitted change.
.idea/

# The worktrees `claude --worktree` makes: each is a checkout of its own.
.claude/worktrees/

# Personal Claude Code files: your own settings and memory, never shared.
.claude/settings.local.json
CLAUDE.local.md
